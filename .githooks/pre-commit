#!/usr/bin/env bash
# Universal pre-commit gate — fires for every commit (Cursor, Claude Code, cloud agents, manual CLI).
# One-time enable per clone:  git config core.hooksPath .githooks
set -euo pipefail
root="$(git rev-parse --show-toplevel)"

"$root/scripts/hooks/secret-scan.sh" || exit 1
"$root/scripts/hooks/project-check.sh" || exit 1
exit 0
