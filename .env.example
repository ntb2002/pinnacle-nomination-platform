# Pinnacle Awards Platform configuration.
# Copy to .env for local development. src/lib/env.ts validates the app's variables at
# boot and the server exits if one is missing or invalid.
# Never commit real secrets. Production values come from the host's secret store.

# --- App (required) ---------------------------------------------------------

# development | test | production (defaults to development)
NODE_ENV=development

# Public base URL, no trailing slash. https is required in production.
# Used for magic links, Stripe return URLs and emails.
APP_URL=http://localhost:3000

# PostgreSQL connection string.
DATABASE_URL=postgresql://pinnacle:pinnacle@localhost:5432/pinnacle_dev

# --- Standalone server (optional) -------------------------------------------
# Read by `node .next/standalone/server.js` (npm start).
# PORT=3000
# HOSTNAME=0.0.0.0

# --- Tests and tooling (optional) -------------------------------------------
# Integration tests (Vitest). Reset on every run: use a dedicated *_test database.
# TEST_DATABASE_URL=postgresql://pinnacle:pinnacle@localhost:5432/pinnacle_test
# Playwright e2e database and port. Reset on every run: use a dedicated *_e2e database.
# E2E_DATABASE_URL=postgresql://pinnacle:pinnacle@localhost:5432/pinnacle_e2e
# E2E_PORT=3100
# Allow db:reset against a non-local or non-*_dev/_test/_e2e database. Dangerous.
# ALLOW_DB_RESET=1
