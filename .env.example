# Pinnacle Awards Platform configuration.
# Copy to .env for local development. src/lib/env.ts validates the app's variables at
# boot and the server exits if one is missing or invalid.
# Never commit real secrets. Production values come from the host's secret store.

# --- App (required) ---------------------------------------------------------

# development | test | production (defaults to development)
NODE_ENV=development

# Public base URL, no trailing slash. https is required in production.
# Used for magic links, Stripe return URLs and emails.
APP_URL=http://localhost:3000

# PostgreSQL connection string.
DATABASE_URL=postgresql://pinnacle:pinnacle@localhost:5432/pinnacle_dev

# Signs session cookies and tokens. At least 32 random characters, unique per environment.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# --- Email ------------------------------------------------------------------
# outbox: mail is written to the email_outbox table and shown at /dev/mailbox (dev/test only).
# smtp:   mail is delivered through SMTP_URL (required in production).
EMAIL_TRANSPORT=outbox
# SMTP_URL=smtps://user:password@smtp.example.edu:465
# Required in production (use an address on a domain with SPF/DKIM set up for the SMTP host).
# Production SMTP must be smtps:// (implicit TLS).
EMAIL_FROM="Pinnacle Awards <no-reply@example.edu>"

# --- Proxies ----------------------------------------------------------------
# How many proxies in front of the app append to X-Forwarded-For (load balancer = 1).
# The client IP used for rate limiting and audit rows is that many entries from the right.
TRUSTED_PROXY_HOPS=1
# Do not set BETTER_AUTH_TRUSTED_ORIGINS: the app refuses to start if it is present.

# --- Standalone server (optional) -------------------------------------------
# Read by `node .next/standalone/server.js` (npm start).
# PORT=3000
# HOSTNAME=0.0.0.0

# --- Tests and tooling (optional) -------------------------------------------
# Integration tests (Vitest). Reset on every run: use a dedicated *_test database.
# TEST_DATABASE_URL=postgresql://pinnacle:pinnacle@localhost:5432/pinnacle_test
# Playwright e2e database and port. Reset on every run: use a dedicated *_e2e database.
# E2E_DATABASE_URL=postgresql://pinnacle:pinnacle@localhost:5432/pinnacle_e2e
# E2E_PORT=3100
# Allow db:reset against a non-local or non-*_dev/_test/_e2e database. Dangerous.
# ALLOW_DB_RESET=1

# --- Demo -------------------------------------------------------------------
# "true" shows a site-wide banner that people, companies and entries are fictional.
# Set it on any deployment loaded with `npm run db:seed` demo data.
DEMO_MODE=false
