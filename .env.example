# Pinnacle Awards Platform configuration.
# Copy to .env for local development. Every variable the app reads is listed here;
# src/lib/env.ts validates them at boot and refuses to start if one is missing or invalid.
# Never commit real secrets. Production values come from the host's secret store.

# development | test | production
NODE_ENV=development

# Public base URL (no trailing slash). Used for magic links, Stripe return URLs, emails.
APP_URL=http://localhost:3000

# PostgreSQL connection string.
DATABASE_URL=postgresql://pinnacle:pinnacle@localhost:5432/pinnacle_dev
