{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git push *)",
      "Bash(gh issue view *)",
      "Bash(gh issue comment *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(scripts/hooks/project-check.sh)",
      "Bash(./scripts/hooks/project-check.sh)",
      "Bash(npx playwright *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx prisma *)",
      "Bash(npx vitest *)"
    ],
    "deny": [
      "Edit(/.github/workflows/**)",
      "Edit(/.githooks/**)",
      "Edit(/scripts/hooks/**)",
      "Edit(/.cursor/hooks.json)",
      "Edit(/.cursor/hooks/**)",
      "Edit(/evals/**)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n *)",
      "Bash(git config core.hooksPath *)",
      "Bash(gh pr merge *)",
      "Bash(git push *refs/heads/main*)"
    ]
  }
}
